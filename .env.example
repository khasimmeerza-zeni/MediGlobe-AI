# MediGlobe AI Environment Configuration Template

# Backend Settings
PROJECT_NAME="MediGlobe AI"
SECRET_KEY="mediglobe-ai-super-secret-production-key-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default for zero-friction local run; PostgreSQL for Docker/prod)
DATABASE_URL="sqlite:///./mediglobe.db"
# DATABASE_URL="postgresql://mediglobe_user:mediglobe_secure_password_2026@localhost:5432/mediglobe_db"

# AI Provider Configuration ("mock", "gemini", or "openai")
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL_NAME="gemini-2.5-flash"

# File Storage
UPLOAD_DIR="./storage/documents"
MAX_UPLOAD_SIZE_MB=25

# Frontend Public Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
